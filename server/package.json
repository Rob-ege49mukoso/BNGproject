
{
  "name": "elema-api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend Node.js de la plateforme Elema API",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "auth:check": "npx auth@latest check schema --config ./src/auth.js",
"auth:generate": "npx auth@latest generate --config ./src/auth.js --output ./better-auth-schema.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-auth": "1.7.18",
"resend": "6.37.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  }
}
